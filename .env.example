APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_LOG_JSON=false
APP_DELIVERY_COST_UPDATE_INTERVAL_MIN=5

POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST=database
POSTGRES_DB=postgres_database

SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_MAX_AGE=2592000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE="lax"

REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=0

#EXCHANGER_SOURCE_URL="https://www.cbr-xml-daily.ru/daily_json.js"
EXCHANGER_REFRESH_HOURS=1

GROQ_MODEL=
GROQ_API_KEY=
GROQ_REASONING_FORMAT=hidden

QDRANT_URL="http://localhost:6333"
QDRANT_HOST="vector-db"
QDRANT_PORT=6333
QDRANT_COLLECTION=knowdlege_base

KNOWLEDGE_BASE_TOP_K=3
KNOWLEDGE_BASE_MIN_SCORE=0.2
